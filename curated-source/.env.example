# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/curated-source.db
UPLOAD_DIR=./uploads
# Comma-separated list of origins allowed to call the API (needed when the SPA is hosted separately, e.g. Hostinger public_html)
CORS_ORIGINS=http://localhost:5173
# Platform commission on net sales (the price of the work, excluding shipping): 0.15 = 15%
PLATFORM_COMMISSION=0.15
# Highest price per work, and per buyer with one gallery over 90 days (keeps sales under the EUR 10,000 AML threshold)
MAX_PRICE_USD=10000
# Load demo galleries, works and test accounts on first boot when the database is empty
AUTO_SEED_DEMO=false
# One-click demo sign-in buttons on the login page (default: on in development, off in production)
SHOW_DEMO_LOGINS=
# Failed sign-ins before an account (and the sending IP) is blocked, and for how long
MAX_FAILED_LOGINS=50
LOGIN_LOCK_HOURS=48

# Social sign-in (buttons appear only when both values of a provider are set)
PUBLIC_URL=https://www.curated-art.shop
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Frontend (build-time). Leave empty when the API is served from the same origin under /api.
VITE_API_URL=
